import { useNavigate, useLocation } from "react-router-dom";
import { FaHome, FaStickyNote, FaCreditCard, FaChartBar, FaUsers, FaCog, FaSignOutAlt, FaBell, FaBars, FaTimes } from "react-icons/fa";
import { useState } from "react";

const Layout = ({ children, activePage }) => {
  const navigate = useNavigate();
  const location = useLocation();
  const [sidebarOpen, setSidebarOpen] = useState(true);
  
  const tenantId = localStorage.getItem("tenantId");
  const userEmail = localStorage.getItem("userEmail");
  const plan = localStorage.getItem("userPlan") || "Free";
  const role = localStorage.getItem("userRole") || "Member";

  const menuItems = [
    { id: "dashboard", label: "Dashboard", icon: <FaHome />, path: "/dashboard" },
    { id: "notes", label: "Notes", icon: <FaStickyNote />, path: "/notes" },
    { id: "subscription", label: "Plans & Pricing", icon: <FaCreditCard />, path: "/subscription", roles: ["Admin", "Owner"] },
    { id: "billing", label: "Billing", icon: <FaCreditCard />, path: "/billing" },
    { id: "analytics", label: "Analytics", icon: <FaChartBar />, path: "/analytics" },
    { id: "team", label: "Team", icon: <FaUsers />, path: "/team", roles: ["Admin", "Owner"] },
    { id: "settings", label: "Settings", icon: <FaCog />, path: "/settings" },
  ];

  const handleLogout = () => {
    localStorage.clear();
    window.location.href = "/login";
  };

  const isActive = (path) => location.pathname === path;

  return (
    <div style={wrapperStyle}>
      {/* Mobile Toggle */}
      <button 
        onClick={() => setSidebarOpen(!sidebarOpen)}
        style={mobileToggle}
      >
        {sidebarOpen ? <FaTimes /> : <FaBars />}
      </button>

      {/* Sidebar */}
      <aside style={{
        ...sidebarStyle,
        transform: sidebarOpen ? 'translateX(0)' : 'translateX(-100%)'
      }}>
        {/* Logo */}
        <div style={logoContainer}>
          <div style={logoIcon}>🚀</div>
          <h2 style={logoText}>SaaSify</h2>
        </div>

        {/* User Info */}
        <div style={userInfo}>
          <div style={userAvatar}>{userEmail?.charAt(0).toUpperCase()}</div>
          <div style={userDetails}>
            <p style={userEmail}>{userEmail}</p>
            <span style={userPlan}>{plan} Plan</span>
          </div>
        </div>

        {/* Navigation */}
        <nav style={navStyle}>
          {menuItems.map((item) => {
            if (item.roles && !item.roles.includes(role)) return null;
            return (
              <div
                key={item.id}
                onClick={() => navigate(item.path)}
                style={{
                  ...menuItem,
                  ...(isActive(item.path) ? menuItemActive : {})
                }}
              >
                <span style={menuIcon}>{item.icon}</span>
                <span>{item.label}</span>
                {isActive(item.path) && <div style={activeIndicator} />}
              </div>
            );
          })}
        </nav>

        {/* Logout */}
        <div style={logoutContainer}>
          <button onClick={handleLogout} style={logoutBtn}>
            <FaSignOutAlt /> Logout
          </button>
        </div>
      </aside>

      {/* Main Content */}
      <main style={mainStyle}>
        {/* Header */}
        <header style={headerStyle}>
          <div>
            <h1 style={pageTitle}>{activePage}</h1>
            <p style={breadcrumb}>Dashboard / {activePage}</p>
          </div>
          <div style={headerRight}>
            <button style={notificationBtn}>
              <FaBell />
              <span style={notificationDot} />
            </button>
          </div>
        </header>

        {/* Content */}
        <div style={contentStyle}>
          {children}
        </div>
      </main>
    </div>
  );
};

